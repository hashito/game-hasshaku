{
  "about": "八尺の画面点検（node tools/review-shots.mjs）。五つの段階の要所、順番を外れた行動（塩なしで皿・札なしで襖・夜の戸を開ける・窓を見続ける）、死亡と復帰、結末2種。実時間で見る場面は ?debug=1。",
  "runs": [
    {
      "name": "l1",
      "query": "?debug=1",
      "steps": [
        { "name": "title", "shot": true },
        { "name": "start-front", "shot": true },
        { "name": "map-board", "at": { "x": 0.5, "z": 20, "yaw": 3.14159, "pitch": -0.05 }, "shot": true },
        { "name": "road-north", "at": { "x": 0.5, "z": -6, "yaw": 0, "pitch": 0 }, "shot": true },
        { "name": "shop-front", "at": { "x": -6.5, "z": -9, "yaw": 1.2, "pitch": 0 }, "shot": true },
        { "name": "shop-counter", "focus": { "x": -15.6, "y": 1, "z": -13.5, "dist": 2 }, "shot": true },
        { "name": "off-house-locked", "focus": { "x": -8, "y": 1.2, "z": 11, "dist": 1.5 }, "keys": ["KeyE"], "wait": 900, "shot": true,
          "expect": "scr.say.join('') || scr.prompt.join('').includes('鍵') || scr.prompt.join('').includes('（') ? true : 'locked door said nothing'" },
        { "name": "sighting", "tasks": ["T_SHOP"], "at": { "x": 3, "z": 10, "yaw": -1.5708, "pitch": 0.05 }, "wait": 2500, "shot": true },
        { "name": "sighting-later", "close": false, "wait": 3000, "shot": true },
        { "name": "grandpa", "focus": { "x": -6.4, "y": 1.3, "z": 16.4, "dist": 2.2 }, "shot": true }
      ]
    },
    {
      "name": "l2",
      "query": "?debug=1",
      "steps": [
        { "name": "k-arrived", "tasks": ["T_SHOP", "T_REPORT"], "focus": { "x": -10.6, "y": 1.3, "z": 15, "dist": 2.4 }, "shot": true },
        { "name": "off-salt-without-bag", "focus": { "x": -10.9, "y": 0.4, "z": 4.1, "dist": 1.4 }, "keys": ["KeyE"], "wait": 900, "shot": true,
          "expect": "scr.say.join('').includes('塩') ? true : 'no reason given: ' + scr.say.join(' ')" },
        { "name": "salt-bag", "focus": { "x": -17, "y": 0.86, "z": 15.2, "dist": 1.3 }, "shot": true },
        { "name": "paper", "focus": { "x": -17, "y": 0.76, "z": 7, "dist": 1.3 }, "shot": true },
        { "name": "photo-record", "focus": { "x": -18.4, "y": 0.76, "z": 9.4, "dist": 1.3 }, "shot": true },
        { "name": "ofuda", "focus": { "x": -10.3, "y": 0.4, "z": 18.45, "dist": 1.3 }, "shot": true },
        { "name": "letter", "focus": { "x": -8.4, "y": 0.34, "z": 16.6, "dist": 1.2 }, "shot": true },
        { "name": "zashiki", "at": { "x": -8, "z": 9.5, "yaw": 0, "pitch": -0.1 }, "wait": 2500, "shot": true },
        { "name": "off-seal-from-outside", "items": ["I_OFUDA"], "at": { "x": -8, "z": 12.2, "yaw": 0, "pitch": -0.05 }, "keys": ["KeyE"], "wait": 900, "shot": true },
        { "name": "zashiki-ready", "items": ["I_SALT", "I_PAPER", "I_OFUDA"], "tasks": ["T_SALT_NW", "T_SALT_NE", "T_SALT_SW", "T_SALT_SE", "T_WINDOW"], "at": { "x": -8, "z": 9, "yaw": 0, "pitch": -0.15 }, "shot": true }
      ]
    },
    {
      "name": "l3",
      "query": "?debug=1",
      "steps": [
        { "name": "night-start", "items": ["I_SALT", "I_PAPER", "I_OFUDA"], "tasks": ["T_SHOP", "T_REPORT", "T_SALT_NW", "T_SALT_NE", "T_SALT_SW", "T_SALT_SE", "T_WINDOW", "T_SEAL"], "at": { "x": -8, "z": 7, "yaw": 0, "pitch": -0.1 }, "wait": 2500, "shot": true },
        { "name": "night-voice", "eval": "window.__hk.st.night = 41;", "at": { "x": -8, "z": 8.5, "yaw": 3.14159, "pitch": 0 }, "wait": 2500, "shot": true },
        { "name": "night-dark-salt", "eval": "const s = window.__hk.st; s.night = 70; for (const k of ['NW','NE']) s.dark[k] = 1.0;", "focus": { "x": -10.9, "y": 0.3, "z": 4.1, "dist": 1.4 }, "wait": 1500, "shot": true },
        { "name": "night-fake-dawn", "eval": "window.__hk.st.night = 132;", "at": { "x": -7, "z": 7, "yaw": -1.5708, "pitch": 0 }, "wait": 2500, "shot": true },
        { "name": "dawn", "close": false, "eval": "window.__hk.skipNight();", "wait": 3500, "shot": true }
      ]
    },
    {
      "name": "l4",
      "query": "?debug=1",
      "steps": [
        { "name": "morning-front", "items": ["I_SALT", "I_PAPER", "I_OFUDA"], "tasks": ["T_SHOP", "T_REPORT", "T_SALT_NW", "T_SALT_NE", "T_SALT_SW", "T_SALT_SE", "T_WINDOW", "T_SEAL", "T_DAWN"], "at": { "x": 0.5, "z": 14, "yaw": 0, "pitch": 0 }, "wait": 2000, "shot": true },
        { "name": "notice", "focus": { "x": -2.8, "y": 1.25, "z": -23.6, "dist": 1.5 }, "shot": true },
        { "name": "gate", "focus": { "x": -1.6, "y": 1, "z": -23.2, "dist": 2.2 }, "shot": true },
        { "name": "shrine-diary", "focus": { "x": 11.6, "y": 0.8, "z": -13.05, "dist": 1.6 }, "shot": true },
        { "name": "creature-close", "eval": "const m = g.monsters.list[0]; if (m && m.ai) { m.ai.pos.x = 0.5; m.ai.pos.z = -10; m.ai.state = 'idle'; } g.teleport({ x: 0.5, z: -4, floor: 0, yaw: 0 }); g.fp.yaw = 0; g.fp.pitch = 0.18;", "wait": 1200, "shot": true },
        { "name": "car-cue", "tasks": ["T_KEY", "T_GATE"], "focus": { "x": 2, "y": 1, "z": -33.5, "dist": 4 }, "wait": 1500, "shot": true }
      ]
    },
    {
      "name": "l5",
      "query": "?debug=1",
      "steps": [
        { "name": "ride-start", "items": ["I_SALT", "I_PAPER", "I_OFUDA"], "tasks": ["T_SHOP", "T_REPORT", "T_SALT_NW", "T_SALT_NE", "T_SALT_SW", "T_SALT_SE", "T_WINDOW", "T_SEAL", "T_DAWN", "T_KEY", "T_GATE", "T_CAR"], "wait": 2500, "shot": true },
        { "name": "ride-roof", "close": false, "eval": "window.__hk.st.ride = 9;", "wait": 1200, "shot": true },
        { "name": "ride-hands", "close": false, "eval": "window.__hk.st.ride = 15; g.fp.yaw = 1.2; g.fp.pitch = 0;", "wait": 1500, "shot": true },
        { "name": "ride-face", "close": false, "eval": "window.__hk.st.ride = 23; window.__hk.st.curse = 0; g.fp.yaw = 1.2; g.fp.pitch = 0;", "wait": 900, "shot": true },
        { "name": "ride-grip", "close": false, "eval": "window.__hk.st.curse = 0; window.dispatchEvent(new KeyboardEvent('keydown', { code: 'KeyE' }));", "wait": 1500, "shot": true }
      ]
    },
    {
      "name": "deaths",
      "query": "?debug=1",
      "steps": [
        { "name": "door-face", "tasks": ["T_SHOP", "T_REPORT"], "eval": "g.die('door');", "wait": 700, "shot": true },
        { "name": "door-window", "close": false, "wait": 2800, "shot": true, "expect": "scr.window.length || document.querySelector('.hk-death') ? true : 'no death window'" },
        { "name": "salt-window", "eval": "g.die('salt');", "wait": 3200, "shot": true },
        { "name": "window-window", "eval": "g.die('window');", "wait": 3200, "shot": true },
        { "name": "monster-window", "eval": "g.die('monster');", "wait": 3200, "shot": true },
        { "name": "respawn", "wait": 1500, "shot": true }
      ]
    },
    { "name": "ending-safe", "steps": [ { "name": "ending", "tasks": ["T_SHOP", "T_REPORT", "T_SALT_NW", "T_SALT_NE", "T_SALT_SW", "T_SALT_SE", "T_WINDOW", "T_SEAL", "T_DAWN", "T_KEY", "T_GATE", "T_CAR", "T_RIDE"], "close": false, "wait": 3500, "shot": true } ] },
    { "name": "ending-remembered", "steps": [ { "name": "ending", "flags": ["records_all"], "tasks": ["T_SHOP", "T_REPORT", "T_SALT_NW", "T_SALT_NE", "T_SALT_SW", "T_SALT_SE", "T_WINDOW", "T_SEAL", "T_DAWN", "T_KEY", "T_GATE", "T_CAR", "T_RIDE"], "close": false, "wait": 3500, "shot": true } ] }
  ]
}
